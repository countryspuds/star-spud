# ─────────────────────────────
# Backend (Java / Gradle) — 세부 규칙은 backend/.gitignore
# ─────────────────────────────
backend/.gradle/
backend/build/
# gradle-wrapper.jar은 커밋해야 하므로 무시하지 않음

# ─────────────────────────────
# Frontend (Node / Vite)
# ─────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.local

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─────────────────────────────
# 환경 변수 (.env.example은 커밋)
# ─────────────────────────────
.env
.env.local
.env.*.local

# ─────────────────────────────
# OS
# ─────────────────────────────
.DS_Store
Thumbs.db

# ─────────────────────────────
# Editor / IDE
# ─────────────────────────────
.idea/
*.swp

# VS Code: 공유할 설정만 남기고 나머지는 무시
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json