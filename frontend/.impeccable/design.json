  "components": [
    {
      "name": "주 버튼",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "길찾기, 감자 심기, 글쓰기 같은 주 동작.",
      "html": "<button class=\"ds-pill ds-primary\">길찾기</button>",
      "css": ".ds-pill { display: inline-flex; align-items: center; justify-content: center; height: 36px; padding: 0 18px; border-radius: var(--radius-pill); border: 1px solid transparent; font-family: var(--font-sans); font-weight: 600; font-size: 14px; white-space: nowrap; cursor: pointer; } .ds-primary { background: var(--blue); color: #fff; } .ds-primary:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }"
    },
    {
      "name": "보조 버튼",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "명소 저장 같은 보조 동작.",
      "html": "<button class=\"ds-pill-2\">명소 저장</button>",
      "css": ".ds-pill-2 { display: inline-flex; align-items: center; justify-content: center; height: 36px; padding: 0 18px; border-radius: var(--radius-pill); background: var(--glass); border: 1px solid var(--edge); color: var(--fg); font-family: var(--font-sans); font-weight: 600; font-size: 14px; cursor: pointer; } .ds-pill-2:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }"
    },
    {
      "name": "입력창",
      "kind": "input",
      "refersTo": "input",
      "description": "폼 입력. 포커스에 라임 링.",
      "html": "<input class=\"ds-input\" placeholder=\"닉네임\" aria-label=\"닉네임\" />",
      "css": ".ds-input { width: 260px; height: 46px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--edge); background: rgba(255, 255, 255, 0.04); color: var(--fg); font-family: var(--font-sans); font-size: 14px; } .ds-input:focus-visible { outline: 2px solid var(--lime); outline-offset: 1px; }"
    },
    {
      "name": "내비게이션",
      "kind": "nav",
      "description": "48px 전역 메뉴. 활성은 밝은 글자.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-on\" href=\"#\">홈</a><a href=\"#\">지도</a><a href=\"#\">캘린더</a><a href=\"#\">프로필</a></nav>",
      "css": ".ds-nav { display: flex; gap: 24px; height: 48px; align-items: center; font-family: var(--font-sans); font-size: 14px; font-weight: 500; } .ds-nav a { color: var(--fg-2); text-decoration: none; transition: color 0.15s; } .ds-nav a:hover, .ds-nav a.ds-on { color: var(--fg); }"
    },
    {
      "name": "탭",
      "kind": "chip",
      "refersTo": "tab-active",
      "description": "지도 탭과 날짜 선택. 활성은 면을 뒤집는다.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab ds-tab-on\">별보기</button><button class=\"ds-tab\">광공해</button></div>",
      "css": ".ds-tabs { display: flex; gap: 6px; } .ds-tab { height: 32px; padding: 0 14px; border: 0; border-radius: var(--radius-pill); background: rgba(22, 27, 36, 0.75); color: #c9d1dd; font-family: var(--font-sans); font-size: 13px; font-weight: 600; cursor: pointer; } .ds-tab:hover { color: #fff; } .ds-tab-on { background: #eaeef5; color: #141414; } .ds-tab:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }"
    },
    {
      "name": "판정 칩",
      "kind": "chip",
      "description": "오늘 밤 판정. 글자색과 같은 테두리, 모르면 점선.",
      "html": "<span class=\"ds-verdict\">좋음</span> <span class=\"ds-verdict ds-unknown\">알 수 없음</span>",
      "css": ".ds-verdict { display: inline-flex; align-items: center; height: 26px; padding: 0 10px; border-radius: var(--radius-pill); border: 1px solid currentColor; font-family: var(--font-sans); font-size: 12px; font-weight: 600; color: var(--sprout); } .ds-unknown { border-style: dashed; color: var(--fg-2); }"
    },
    {
      "name": "카드",
      "kind": "card",
      "refersTo": "card-solid",
      "description": "기본 표면. 22px 모서리, 1px 테두리, 그림자 없음.",
      "html": "<section class=\"ds-card\"><span class=\"ds-label\">Star score · 5 km grid</span><h3 class=\"ds-title\">별보기 지도</h3></section>",
      "css": ".ds-card { width: 280px; padding: 18px 20px; border-radius: var(--radius-card); border: 1px solid var(--edge); background: var(--card); color: var(--fg); font-family: var(--font-sans); } .ds-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-2); } .ds-title { margin: 4px 0 0; font-size: 18px; font-weight: 600; }"
    },
    {
      "name": "세부값 타일",
      "kind": "custom",
      "refersTo": "tile",
      "description": "밝은 면의 조건 값. 글자색을 함께 지정한다.",
      "html": "<div class=\"ds-tile\"><span class=\"ds-tile-label\">구름량</span><span class=\"ds-tile-value\">40%</span><span class=\"ds-tile-sub\">전운량 예보</span></div>",
