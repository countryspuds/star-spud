# 복사해서 사용: cp .env.example .env

# PostgreSQL + PostGIS (docker-compose.yml)
POSTGRES_DB=starspud
POSTGRES_USER=starspud
POSTGRES_PASSWORD=starspud
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# 외부 API 키 (추후 사용)
# KMA_API_KEY=        # 기상청
# KASI_API_KEY=       # 한국천문연구원
# KAKAO_REST_API_KEY=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
